    {
      "uid": "81a2b144-b7af-4a21-9918-e0f7bb483196",
      "id": 24,
      "name": "Klopný obvod RS z NOR",
      "category": "sequential",
      "description": "Dvě hradla NOR se zpětnou vazbou. S = 1 nastaví Q = 1, R = 1 nuluje, S = R = 0 pamatuje. S = R = 1 je zakázaný stav (Q = Qn = 0). Po zapnutí je stav neurčený (X), dokud se obvod nenastaví nebo nevynuluje.",
      "translations": {
        "en": {
          "name": "RS flip-flop from NOR",
          "description": "Two NOR gates with feedback. S = 1 sets Q = 1, R = 1 resets, S = R = 0 holds. S = R = 1 is the forbidden state (Q = Qn = 0). After power-up the state is undefined (X) until the circuit is set or reset."
        }
      },
      "author": "Mgr. Stanislav Jan Fidrmuc",
