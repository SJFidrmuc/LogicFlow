    {
      "uid": "6b88169d-604a-44c5-ada8-0a29ed772234",
      "id": 33,
      "name": "Kruhový čítač 4 bity",
      "category": "sequential",
      "description": "Posuvný registr uzavřený do kruhu (Q3 → D) s jedinou jedničkou, která obíhá: Q0 → Q1 → Q2 → Q3 → Q0. Po spuštění je Q0 = 1 (počáteční stav klopného obvodu). Hodí se k postupnému spínání (běžící světlo).",
      "translations": {
        "en": {
          "name": "4-bit ring counter",
          "description": "A shift register closed into a ring (Q3 → D) with a single one that circulates: Q0 → Q1 → Q2 → Q3 → Q0. After start Q0 = 1 (the flip-flop's initial state). Useful for sequential switching (running light)."
        }
      },
