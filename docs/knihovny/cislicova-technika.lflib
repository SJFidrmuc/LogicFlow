  "library": {
    "uid": "22e3b7de-7bdd-429b-8c26-275bf7a1298e",
    "name": "Číslicová technika – výukové prvky",
    "description": "Hradlová zapojení běžných úloh číslicové techniky: hradla z NAND a NOR, kombinační obvody, sčítačky a odčítačky, klopné obvody, čítače, registry a aplikace. Každý prvek je ověřený simulací.",
    "translations": {
      "en": {
        "name": "Digital electronics – teaching elements",
        "description": "Gate-level circuits of common digital electronics tasks: gates from NAND and NOR, combinational circuits, adders and subtractors, flip-flops, counters, registers and applications. Every item is verified by simulation."
      }
    },
    "author": "Mgr. Stanislav Jan Fidrmuc",
    "license": "CC BY 4.0",
    "version": 1,
    "created": "2026-11-22",
    "modified": "2026-11-22"
  },
