    {
      "uid": "a6144984-2be9-41c5-bd02-86ea04040000",
      "id": 14,
      "name": "Sčítačka 4bitová",
      "category": "arithmetic",
      "description": "Vnitřní zapojení bloku Σ: 4 úplné sčítačky (1 bit) za sebou, přenos CO každého řádu vede do CI vyššího (sčítačka s postupným přenosem). Tabem jde otevřít úplnou sčítačku až na hradla.",
      "translations": {
        "en": {
          "name": "Adder 4-bit",
          "description": "Internal circuit of the Σ block: 4 full adders (1 bit) in a row, the carry CO of every position goes to CI of the next one (ripple-carry adder). Tab opens the full adder down to gates."
        }
      },
      "author": "Mgr. Stanislav Jan Fidrmuc",
