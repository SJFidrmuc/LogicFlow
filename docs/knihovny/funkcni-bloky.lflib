    {
      "uid": "cf087cb5-9698-4cd9-afb6-7c375249e241",
      "id": 2,
      "name": "Klopný obvod T s nulováním (z D)",
      "category": "sequential",
      "description": "Klopný obvod T řízený náběžnou hranou C s asynchronním nulováním R: klopný obvod D, na jehož vstup vede T ⊕ Q. Při T = 1 se hranou překlopí, při T = 0 drží stav. Tabem jde otevřít klopný obvod D až na hradla NAND.",
      "translations": {
        "en": {
          "name": "T flip-flop with reset (from D)",
          "description": "Rising-edge triggered T flip-flop with asynchronous reset R: a D flip-flop whose input gets T ⊕ Q. With T = 1 it toggles on the edge, with T = 0 it holds its state. Tab opens the D flip-flop down to NAND gates."
        }
      },
      "author": "Mgr. Stanislav Jan Fidrmuc",
      "license": "CC BY 4.0",
      "version": 1,
      "created": "2026-11-27",
      "modified": "2026-11-27",
