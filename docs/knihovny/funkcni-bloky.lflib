{
  "format": 1,
  "type": "logicflow-library",
  "app": "LogicFlow 0.3.1",
  "library": {
    "uid": "a6144984-2be9-41c5-bd02-86eaa1f135ba",
    "name": "Funkční bloky – vnitřní zapojení",
    "description": "Vnitřní zapojení všech funkčních bloků programu (multiplexor, dekodér, kodér, sčítačka, komparátor, převodník BCD na 7 segmentů, čítač, registr, posuvný registr) z hradel, se stejně pojmenovanými vývody. Sekvenční bloky jsou z klopných obvodů D ze šesti hradel NAND, takže jde každý blok rozkliknout Tabem až na hradla. Každý prvek je ověřený proti simulaci bloku.",
    "translations": {
      "en": {
        "name": "Function blocks – internal circuits",
        "description": "Gate-level internal circuits of all function blocks of the program (multiplexer, decoder, encoder, adder, comparator, BCD to 7-segment decoder, counter, register, shift register) with pins of the same names. Sequential blocks are made of D flip-flops from six NAND gates, so every block can be opened with Tab down to gates. Every item is verified against the simulation of the block."
      }
    },
    "author": "Mgr. Stanislav Jan Fidrmuc",
    "license": "CC BY 4.0",
    "version": 1,
    "created": "2026-11-27",
    "modified": "2026-11-27"
  },
  "items": [
    {
      "uid": "2fb61d2d-120f-4578-bc83-37cb2672d765",
      "id": 1,
      "name": "Klopný obvod D s nulováním (z NAND)",
      "category": "sequential",
      "description": "Klopný obvod D řízený náběžnou hranou C s asynchronním nulováním R (aktivní v 1) ze šesti hradel NAND – zapojení obvodu 7474. Dvě vstupní paměti RS si při C = 0 připraví D; náběžná hrana C podle něj nastaví nebo vynuluje výstupní paměť a dokud je C = 1, změny D už neprojdou. R = 1 nuluje hned, bez ohledu na hodiny. Po spuštění simulace je stav neznámý (X), dokud nepřijde hrana C nebo R.",
      "translations": {
        "en": {
          "name": "D flip-flop with reset (from NAND)",
          "description": "Rising-edge triggered D flip-flop with asynchronous reset R (active high) from six NAND gates – the circuit of the 7474. Two input RS latches prepare D while C = 0; the rising edge of C sets or resets the output latch accordingly and while C = 1 changes of D no longer pass. R = 1 resets at once, regardless of the clock. After the simulation starts the state is unknown (X) until an edge of C or R comes."
        }
      },
      "author": "Mgr. Stanislav Jan Fidrmuc",
      "license": "CC BY 4.0",
      "version": 1,
      "created": "2026-11-27",
      "modified": "2026-11-27",
