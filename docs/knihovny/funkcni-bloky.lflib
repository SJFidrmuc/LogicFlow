    {
      "uid": "a6144984-2be9-41c5-bd02-86ea05030000",
      "id": 17,
      "name": "Komparátor 3bitový",
      "category": "arithmetic",
      "description": "Vnitřní zapojení bloku COMP: pro každý bit hradlo XNOR (Ai = Bi) a AND (Ai · ¬Bi). A>B rozhodne nejvyšší bit, ve kterém se čísla liší (porovnává se od A2/B2 dolů), A=B je součin všech XNOR a A<B = ¬(A>B + A=B).",
      "translations": {
        "en": {
          "name": "Comparator 3-bit",
          "description": "Internal circuit of the COMP block: for every bit an XNOR gate (Ai = Bi) and an AND gate (Ai · ¬Bi). A>B is decided by the highest bit in which the numbers differ (compared from A2/B2 downwards), A=B is the AND of all XNORs and A<B = ¬(A>B + A=B)."
        }
      },
      "author": "Mgr. Stanislav Jan Fidrmuc",
      "license": "CC BY 4.0",
      "version": 1,
      "created": "2026-11-27",
      "modified": "2026-11-27",
      "inputs": [
        "A0",
        "A1",
        "A2",
        "B0",
        "B1",
        "B2"
      ],
      "outputs": [
        "A<B",
        "A=B",
        "A>B"
      ],
