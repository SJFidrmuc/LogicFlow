    {
      "uid": "a6144984-2be9-41c5-bd02-86ea05040000",
      "id": 18,
      "name": "Komparátor 4bitový",
      "category": "arithmetic",
      "description": "Vnitřní zapojení bloku COMP: pro každý bit hradlo XNOR (Ai = Bi) a AND (Ai · ¬Bi). A>B rozhodne nejvyšší bit, ve kterém se čísla liší (porovnává se od A3/B3 dolů), A=B je součin všech XNOR a A<B = ¬(A>B + A=B).",
      "translations": {
        "en": {
          "name": "Comparator 4-bit",
          "description": "Internal circuit of the COMP block: for every bit an XNOR gate (Ai = Bi) and an AND gate (Ai · ¬Bi). A>B is decided by the highest bit in which the numbers differ (compared from A3/B3 downwards), A=B is the AND of all XNORs and A<B = ¬(A>B + A=B)."
        }
      },
      "author": "Mgr. Stanislav Jan Fidrmuc",
      "license": "CC BY 4.0",
      "version": 1,
      "created": "2026-11-27",
