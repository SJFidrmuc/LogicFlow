    {
      "uid": "ce146411-078a-4bdc-8ad0-5b80bbab6fa4",
      "id": 1,
      "name": "Úplná sčítačka 1 bit",
      "category": "arithmetic",
      "description": "Úplná sčítačka 1 bit se vstupním a výstupním přenosem: S = A ⊕ B ⊕ Cin, Cout = A·B + Cin·(A ⊕ B). Řetězením (Cout → Cin) vznikne vícebitová sčítačka.",
      "translations": {
        "en": {
          "name": "1-bit full adder",
          "description": "Full adder with carry in and carry out: S = A ⊕ B ⊕ Cin, Cout = A·B + Cin·(A ⊕ B). Chaining (Cout → Cin) gives a multi-bit adder."
        }
      },
      "author": "Stanislav Jan Fidrmuc",
