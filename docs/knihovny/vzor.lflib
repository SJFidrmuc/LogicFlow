    "name": "Vzorová knihovna",
    "description": "Vzor formátu .lflib: úplná sčítačka 1 bit a 2bitová sčítačka, která ji používá.",
    "translations": {
      "en": {
        "name": "Sample library",
        "description": "Sample of the .lflib format: a 1-bit full adder and a 2-bit adder that uses it."
      }
    },
    "author": "Stanislav Jan Fidrmuc",
    "license": "CC BY 4.0",
